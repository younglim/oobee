<div class="segmented-tabs" role="tablist" aria-label="<%= t('aboutScan.crawlViews') %>">
  <button
    type="button"
    id="seg-scanned"
    class="seg-pill"
    role="tab"
    aria-controls="pages-scanned"
    aria-selected="true"
    tabindex="0"
    data-tab-target="#pages-scanned"
  >
    <span id="totalPagesScannedLabel">
      <%= t('common.na') %>
    </span>
    <span>
      &nbsp;<%= t('aboutScan.pagesScanned') %>
    </span>
  </button>

  <button
    type="button"
    id="seg-not-scanned"
    class="seg-pill"
    role="tab"
    aria-controls="pages-not-scanned"
    aria-selected="false"
    tabindex="-1"
    data-tab-target="#pages-not-scanned"
  >
    <span id="totalPagesNotScannedLabel">
      <%= t('common.na') %>
    </span>
    <span>
      &nbsp;<%= t('aboutScan.pagesNotScanned') %>
    </span>
  </button>

  <button
    type="button"
    id="seg-unsupported"
    class="seg-pill"
    role="tab"
    aria-controls="pages-unsupported"
    aria-selected="false"
    tabindex="-1"
    data-tab-target="#pages-unsupported"
  >
    <span id="totalUnsupportedDocsLabel">
      <%= t('common.na') %>
    </span>
    <span>
      &nbsp;<%= t('aboutScan.unsupportedDocuments') %>
    </span>
  </button>
</div>
