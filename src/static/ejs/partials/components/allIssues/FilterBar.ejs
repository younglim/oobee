<div class="filter-bar">
  <div class="filter-dropdowns">
    <select id="severityFilter" class="filter-dropdown" aria-label="<%= t('allIssues.filterBySeverity') %>">
      <option value="all"><%= t('allIssues.allSeverityGroups') %></option>
      <option value="mustFix"><%= t('common.category.mustFix') %></option>
      <option value="goodToFix"><%= t('common.category.goodToFix') %></option>
      <option value="needsReview"><%= t('allIssues.manualReview') %></option>
    </select>

    <select id="criteriaFilter" class="filter-dropdown" aria-label="<%= t('allIssues.filterByCriteria') %>">
      <option value="all"><%= t('allIssues.allFailedCriteria') %></option>
      <!-- Dynamically populated -->
    </select>

    <select id="disabilityFilter" class="filter-dropdown" aria-label="<%= t('allIssues.filterByDisability') %>">
      <option value="all"><%= t('allIssues.allDisabilities') %></option>
      <option value="Visual"><%= t('disability.one', { a: t('disability.names.Visual') }) %></option>
      <option value="Hearing"><%= t('disability.one', { a: t('disability.names.Hearing') }) %></option>
      <option value="Motor"><%= t('disability.one', { a: t('disability.names.Motor') }) %></option>
      <option value="Learning"><%= t('disability.one', { a: t('disability.names.Learning') }) %></option>
    </select>
  </div>

  <div class="search-container">
    <input 
      type="text" 
      id="issuesSearchInput" 
      class="search-input" 
      placeholder="<%= t('allIssues.search') %>"
      aria-label="<%= t('allIssues.searchIssues') %>"
    />
  </div>
</div>
