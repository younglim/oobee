<script>
  (function () {
    const btns = Array.from(document.querySelectorAll('.js-view-btn'));
    const panes = Array.from(document.querySelectorAll('[data-viewpane]'));

    function showPane(targetId) {
      // hide all panes
      panes.forEach(p => p.hidden = true);
      // collapse all buttons
      btns.forEach((b) => {
        b.setAttribute('aria-expanded', 'false');
        b.closest('li')?.classList.remove('about-scan-toggle-active');
      });

      // show the requested pane
      const pane = document.getElementById(targetId);
      if (pane) {
        pane.hidden = false;

        // mark the controlling button active
        const btn = btns.find(b => b.getAttribute('aria-controls') === targetId);
        if (btn) {
          btn.setAttribute('aria-expanded', 'true');
          btn.closest('li')?.classList.add('about-scan-toggle-active');
        }

        // move focus to the pane heading for screen readers/keyboard users
        const h = pane.querySelector('h4, h3, h2, [role="heading"]');
        if (h) h.setAttribute('tabindex', '-1'), h.focus();
      }
    }

    btns.forEach(b => {
      b.addEventListener('click', () => showPane(b.getAttribute('aria-controls')));
      // make Enter/Space work if someone adds role="tab" later
      b.addEventListener('keydown', (e) => {
        if (e.key === ' ' || e.key === 'Enter') { e.preventDefault(); b.click(); }
      });
    });

    // initial state: ensure only crawl is visible (or switch here if you prefer WCAG)
    showPane('view-crawl');
  })();

  const formatPageCount = (count) => Number(count).toLocaleString(t('common.numberLocale'));
  const scannedPagesTotal = Number(scanData.totalPagesScanned) || 0;
  const notScannedPagesTotal = Number(scanData.totalPagesNotScanned) || 0;
  const inspectPresetPageTotal = scannedPagesTotal + notScannedPagesTotal;
  const scannedPagesText = tCount('common.pageCount', scannedPagesTotal);
  const rawLabel = (scanData.customFlowLabel ?? '').trim();
  const displayLabel = !rawLabel || rawLabel.toLowerCase() === 'none'
    ? t('aboutScan.customFlow')
    : rawLabel;

  const crawlTitle = scanData.isCustomFlow
    ? t('aboutScan.customFlowTitle', { label: displayLabel, pages: scannedPagesText })
    : t('aboutScan.crawlTitle', { scanType: scanData.scanType, pages: scannedPagesText });
  const inspectPresetPagesText = t(`common.pageCount.${inspectPresetPageTotal === 1 ? 'one' : 'other'}`, {
    count: formatPageCount(inspectPresetPageTotal),
  });
  const modalLabel = scanData.isInspectPresetScan
    ? t('aboutScan.inspectPresetTitle', { pages: inspectPresetPagesText })
    : crawlTitle;
  const modalToggleLabel = scanData.isInspectPresetScan
    ? t('aboutScan.inspectPresetToggle', { pages: inspectPresetPagesText })
    : crawlTitle;

  document.getElementById('pagesScannedModalLabel').textContent = modalLabel;
  document.getElementById('pagesScannedModalToggleTxt').textContent = modalToggleLabel;
</script>
